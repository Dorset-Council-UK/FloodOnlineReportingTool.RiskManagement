    "sass": "^1.70.0",
    "sass-loader": "^14.1.0",
    "eslint": "9.26.0",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
