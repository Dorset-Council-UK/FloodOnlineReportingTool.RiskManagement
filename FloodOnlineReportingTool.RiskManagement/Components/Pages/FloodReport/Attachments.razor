@page "/report/attachments/{Reference}"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>
<GdsBreadcrumbs Items="Breadcrumbs" />

<AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
    <Authorized>
        <GdsSpinner Show="_isLoading" ShowMessage="true" />

        <GdsHeading Level="2">@Title</GdsHeading>

        Insert the attachments component here. This is a placeholder for the actual attachments functionality.

        <GdsButton IsSubmit="false" OnClick="@GoToUpload" Text="Upload Attachments" AdditionalCssClasses="govuk-button--secondary no-print" />

    </Authorized>
    <NotAuthorized>
        <GdsWarning Text="You do not have permission to view flood reports. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>
