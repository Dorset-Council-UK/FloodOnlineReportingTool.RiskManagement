@page "/report/details/{Reference}"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using FloodOnlineReportingTool.RiskManagement.Models.Order
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Flood report</PageTitle>
<GdsBreadcrumbs Items="Breadcrumbs" />

<AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
    <Authorized>
        <GdsSpinner Show="_isLoading" ShowMessage="true" />
        @if (_gettingToken)
        {
            <p>Please wait whilst we authenticate you...</p>
        }
        else if (_notFound)
        {
            <GdsHeading Level="1">The flood report could not be found</GdsHeading>
            <p>If you typed the web address, check it is correct.</p>
            <p>If you pasted the web address, check you copied the entire address.</p>
            <p>If the web address is correct or you selected a link or button, contact the site administrators to get help.</p>
            <GdsHeading Level="2">Next steps</GdsHeading>
            <p><GdsLink Href="@(GeneralPages.Home.Url)">Go back to the home page</GdsLink></p>
            <p><GdsLink Href="@(SearchPages.Home.Url)">Search for another report</GdsLink></p>
        }
        else if (!_isLoading && ViewModel is not null)
        {
            var firstSource = ViewModel.SourceRecords?.FirstOrDefault();

            <GdsHeading Level="1">Flood report @ViewModel.Reference</GdsHeading>

            <GdsGridRow AdditionalCssClasses="govuk-!-margin-bottom-2">
                <GdsGridColumn Width="GdsGridColumnWidth.TwoThirds" AdditionalCssClasses="print-main-column">

                    @* TODO - add working link to full report to button *@
                    <GdsButton AdditionalCssClasses="no-print" Text="View the complete report" />

                    @* TODO - add action buttons functionality once decided *@
                    <div class="govuk-button-group no-print">
                        <EditForm EditContext="_actionsEditContext">
                            <GdsErrorSummary />

                            @if (AcknowledgeAction is not null)
                            {
                                <GdsButton IsSubmit="false" PreventDoubleClick AdditionalCssClasses="govuk-button--secondary" Text="Acknowledge Report" OnClick="@AcknowledgeAsync" />
                            }
                            <GdsButton IsSubmit="false" Text="Action 2" AdditionalCssClasses="govuk-button--secondary" />
                            <GdsButton IsSubmit="false" Text="Action 3" AdditionalCssClasses="govuk-button--secondary" />
                            <GdsButton IsSubmit="false" Text="Action 4" AdditionalCssClasses="govuk-button--secondary" />
                        </EditForm>
                    </div>

                    <GdsHeading Level="2">Basic details</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Reference
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.Reference
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Reported on
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.CreatedUtc.GdsReadable()
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Last updated
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @if (ViewModel.UpdatedAt == default)
                                {
                                    <span>-</span>
                                }
                                else if (string.IsNullOrWhiteSpace(ViewModel.UpdatedBy))
                                {
                                    <span>@ViewModel.UpdatedAt.GdsReadable()</span>
                                }
                                else
                                {
                                    <span>@ViewModel.UpdatedAt.GdsReadable() by @ViewModel.UpdatedBy</span>
                                }
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Record status
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ReportStatus
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="2">About the flood</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood location
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.LocationDescription
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood map
                            </dt>
                            <dd class="govuk-summary-list__value">
                                <div class="flood-map-container">
                                    <MiniMap Geometry="@ViewModel.Geom" />
                                </div>
                            </dd>
                        </div>
                    </dl>

                    @if (ViewModel.SourceRecords.Count == 0)
                    {
                        <GdsWarning Text="Source record information is missing." />
                    }
                    else if (ViewModel.SourceRecords.Count == 1)
                    {
                        <SourceSummary SourceRecord="@ViewModel.SourceRecords.First()" />
                    }
                    else
                    {
                        <GdsHeading Level="2">Source Records</GdsHeading>
                        <GdsTabs Title="Options">
                            @foreach (var source in ViewModel.SourceRecords)
                            {
                                // TODO - We don't want a heading in these panels
                                <GdsTabPanel Id="@source.Reference" Heading="@source.Reference" HeadingClass="govuk-visually-hidden">
                                    <SourceSummary SourceRecord="@source" />
                                </GdsTabPanel>
                            }
                        </GdsTabs>
                    }
                </GdsGridColumn>

                <GdsGridColumn Width="GdsGridColumnWidth.OneThird" AdditionalCssClasses="no-print">
                    <GdsHeading Level="2" Size="GdsSize.Small">Further details</GdsHeading>
                    <p><GdsLink Href="@($"report/attachments/{Reference}")">Attached Documents</GdsLink></p>
                    <p><GdsLink Href="@($"report/comments/{Reference}")">Comments</GdsLink></p>
                    <hr class="govuk-section-break govuk-section-break--m" />

                    <GdsHeading Level="2" Size="GdsSize.Small">Download the data</GdsHeading>
                    @if (!string.IsNullOrEmpty(_exportErrorMessage))
                    {
                        <GdsWarning Text="@_exportErrorMessage" />
                    }
                    <p><a href="@_selfUrl" @onclick="PrintPageAsync" @onclick:preventDefault="true">Print/Save page</a></p>
                    <p><button class="govuk-link" @onclick="ExportToCsv" disabled="@_isExportingCsv"><span class="govuk-visually-hidden">Download </span>CSV</button></p>
                    @if (ViewModel.Geom is not null && ViewModel.Geom.NumGeometries is not 0)
                    {
                        <p><button class="govuk-link" @onclick="ExportToJson" disabled="@_isExportingJson"><span class="govuk-visually-hidden">Download </span>GeoJSON</button></p>
                    }
                </GdsGridColumn>
            </GdsGridRow>
        }

    </Authorized>
    <NotAuthorized>
        <GdsWarning Text="You do not have permission to view flood reports. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>
