@page "/report/details/{Reference}"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Flood report</PageTitle>
<GdsBreadcrumbs Items="Breadcrumbs" />

<AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
    <Authorized>
        <GdsSpinner Show="_isLoading" ShowMessage="true" />
        @if (_gettingToken)
        {
            <p>Please wait whilst we authenticate you...</p>
        }
        else if (_notFound)
        {
            <GdsWarning Text="Flood report not found." />
        }
        else if (!_isLoading && ViewModel is not null)
        {
            var firstSource = ViewModel.SourceRecords?.FirstOrDefault();

            <GdsHeading Level="2">View flood report summary</GdsHeading>

            <GdsGridRow AdditionalCssClasses="govuk-!-margin-bottom-2">  
                <GdsGridColumn Width="GdsGridColumnWidth.TwoThirds" AdditionalCssClasses="print-main-column">

                    @* TODO - add working link to full report to button *@
                    <GdsButton AdditionalCssClasses="no-print" Text="View the complete report" />

                    @* TODO - add action buttons functionality once decided *@
                    <div class="govuk-button-group no-print">
                        <EditForm EditContext="_actionsEditContext">
                            <GdsErrorSummary />
                
                            @if (AcknowledgeAction is not null)
                            {
                                <GdsButton IsSubmit="false" PreventDoubleClick AdditionalCssClasses="govuk-button--secondary" Text="Acknowledge Report" OnClick="@AcknowledgeAsync" />
                            }
                            <GdsButton IsSubmit="false" Text="Action 2" AdditionalCssClasses="govuk-button--secondary" />
                            <GdsButton IsSubmit="false" Text="Action 3" AdditionalCssClasses="govuk-button--secondary" />
                            <GdsButton IsSubmit="false" Text="Action 4" AdditionalCssClasses="govuk-button--secondary" />
                        </EditForm>
                    </div>

                    <GdsHeading Level="3">Basic details</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Reference
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.Reference
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Reported on
                            </dt>
                            <dd class="govuk-summary-list__value">
@(firstSource is not null ? firstSource.CreatedUtc.GdsReadable() : "Unknown date")
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Record status
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ReportStatus
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="3">About the flood</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood location
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @* TODO - add flood location data *@
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood map
                            </dt>
                            <dd class="govuk-summary-list__value">
                                <div class="flood-map-container">
                                    <MiniMap Geometry="@firstSource?.Geom" />
                                </div>
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood cause
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @* TODO - add flood cause data *@
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Is the flood ongoing?
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @* TODO - add flood ongoing status *@
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Uninhabitable?
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @* TODO - add uninhabitable status *@
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Vulnerable people?
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @* TODO - add vulnerable people data *@
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="3">Contacts</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Contacts available
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @* TODO - add contacts available data *@
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="3">Organisations</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Lead organisation
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @* TODO - add lead organisation data *@
                            </dd>
                        </div>
                    </dl>
                </GdsGridColumn>

                <GdsGridColumn Width="GdsGridColumnWidth.OneThird" AdditionalCssClasses="no-print">
                    <GdsHeading Level="4">Further details</GdsHeading>
                    <p><a href="">Media</a></p>
                    <p><a href="">Comments</a></p>
                    <hr class="govuk-section-break govuk-section-break--m" />

                    <GdsHeading Level="4">Download the data</GdsHeading>
                    <p><a href="@_selfUrl" @onclick="PrintPageAsync" @onclick:preventDefault="true">Print/Save page</a></p>
                    <p><a href="@ExportToCsv()" download="@CsvDownloadFileName">CSV</a></p>
                    <p><a href="@ExportToJson()" download="@JsonDownloadFileName">GeoJSON</a></p>
                </GdsGridColumn>
            </GdsGridRow>
        }

    </Authorized>
    <NotAuthorized>
        <GdsWarning Text="You do not have permission to view flood reports. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>

