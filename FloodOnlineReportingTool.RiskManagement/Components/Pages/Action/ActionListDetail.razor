@using FloodOnlineReportingTool.Database.Models.Actions
@using Microsoft.AspNetCore.Components.QuickGrid

<p>Manage actions for you or your team to perform.</p>

<div class="grid">
    <QuickGrid @ref="_grid" ItemsProvider="ItemsProvider" Pagination="_pagination" class="govuk-table quickgrid-hide-empty-rows">
        <TemplateColumn Title="Logged" Sortable="true" SortBy="GridSort<ActionLog>.ByAscending(x => x.LoggedAt)">
            @context.LoggedAt.GdsReadable()
        </TemplateColumn>
        <TemplateColumn Title="Action" Sortable="true" SortBy="GridSort<ActionLog>.ByAscending(x => x.Action.Description)">
            @context.Action.Description
        </TemplateColumn>
        <TemplateColumn Title="Report reference" Sortable="true" SortBy="GridSort<ActionLog>.ByAscending(x => x.ReportReference)">
            @context.ReportReference
        </TemplateColumn>
        <TemplateColumn Title="">
            <a href="action/@context.Id">Take action</a>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="_pagination" />
</div>
