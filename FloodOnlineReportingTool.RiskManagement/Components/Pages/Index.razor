@attribute [AllowAnonymous]
@page "/"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Flood Reporting Admin</PageTitle>

<h1 class="govuk-heading-l">Flood Reporting Admin</h1>

<AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
    <Authorized>
        <GdsContainer>
            <GdsGridRow>
                <GridCard CardSize="GridCard.CardSizes.OneHalf" BodyText="Flood events recorded in the last 30 days" HeaderText="@_past30DaysCount.ToString()" CardStyle="@_userEventStyle" />
                <GridCard CardSize="GridCard.CardSizes.OneHalf" BodyText="Flooded properties recorded in the last 30 days" HeaderText="@_userPropertyCount.ToString()" CardStyle="@_userPropertyStyle" />
            </GdsGridRow>
            <GdsGridRow>
                <GridCard CardSize="GridCard.CardSizes.OneHalf" BodyText="Action waiting for you" HeaderText="@_userActionCount.ToString()" CardStyle="@_userActionStyle" LinkURL="action" />
                <GridCard CardSize="GridCard.CardSizes.OneHalf" BodyText="Create a new search" HeaderText="Search for records" CardStyle="info" LinkURL="search" />
            </GdsGridRow>

            <GdsGridRow>
                <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                    <h3>Other tasks</h3>

                    <ul class="govuk-list">
                        <li>
                            <a class="govuk-link" href="flood-event">Create a new flood event</a>
                        </li>
                        <li>
                            <a class="govuk-link" href="#">Create a property log / record site visits</a>
                        </li>
                    </ul>
                </GdsGridColumn>

                <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                    <h3>Pick up where you left off</h3>
                    <RecentWorkList />
                </GdsGridColumn>
            </GdsGridRow>
        </GdsContainer>
    </Authorized>
    <NotAuthorized>
            <GdsWarning Text="Please sign in to view your dashboard" />
    </NotAuthorized>
</AuthorizeView>

                        