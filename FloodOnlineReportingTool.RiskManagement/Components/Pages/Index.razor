@page "/"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using FloodOnlineReportingTool.RiskManagement.Components.Search
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@_title</PageTitle>

<h1 class="govuk-heading-l">@_title</h1>

<GdsSpinner Show="_isLoading" ShowMessage="true" />

<h2>Testing authtenication here</h2>
<AuthorizeView>
    <Authorized>
        <p>Authorised as @context.User.Identity?.Name</p>
        <p>
            Claims:
            <ul>
                @foreach (var claim in context.User.Claims)
                {
                    <li>@claim.Type : @claim.Value</li>
                }
            </ul>
        </p>
        <AuthorizeView Policy="@PolicyNames.Reader" Context="readerContext">
            <Authorized><p>Authorised 'Reader' policy.</p></Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@PolicyNames.Writer" Context="writerContext">
            <Authorized><p>Authorised 'Writer' policy</p></Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@PolicyNames.Admin" Context="adminContext">
            <Authorized><p>Authorised 'Admin' policy</p></Authorized>
        </AuthorizeView>
    </Authorized>
    <Authorizing><p><GdsSpinner Show="@true" ShowMessage="true" Message="Authorising..." /></p></Authorizing>
    <NotAuthorized>
        <p>Not authorised</p>
    </NotAuthorized>
</AuthorizeView>

<div><a href="signin" class="govuk-link">Sign in</a></div>
<div><a href="signout" class="govuk-link">Sign out</a></div>

<h2>Normal content below</h2>
<AuthorizeView>
    <Authorized>
        <p>Logged in as <a class="govuk-link" href="account/myaccount">@context.User.Identity?.Name</a></p>

        <h2 class="govuk-heading-m">Search</h2>
        <SearchFloodReports />

        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <GridCard CardSize="GridCard.CardSizes.OneHalf" BodyText="Flood searches saved in the last 30 days" HeaderText="4" CardStyle="success" />
                <GridCard CardSize="GridCard.CardSizes.OneHalf" BodyText="Flood events recorded in the last 30 days" HeaderText="2" CardStyle="success" />
            </div>
            <div class="govuk-grid-row">
                <GridCard CardSize="GridCard.CardSizes.OneHalf" BodyText="Action waiting for you" HeaderText="1" CardStyle="warning" />
                <GridCard CardSize="GridCard.CardSizes.OneHalf" BodyText="Create a new property search" HeaderText="Property Searches" CardStyle="success" />
            </div>

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-half">
                    <h3>Other tasks</h3>

            <ul class="govuk-list">
                <li>
                    <a class="govuk-link" href="flood-event">Create a new flood event</a>
                </li>
                <li>
                    <a class="govuk-link" href="#">Create a property log / record site visits</a>
                </li>
            </ul>

                </div>
                <div class="govuk-grid-column-one-half">
                    <h3>Pick up where you left off</h3>

                    <ul class="govuk-list">
                        <li>
                            <a class="govuk-link" href="#">Recent page 1</a>
                        </li>
                        <li>
                            <a class="govuk-link" href="#">Recent page 2</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>Sorry, you are not able to use this application.</p>
    </NotAuthorized>
</AuthorizeView>