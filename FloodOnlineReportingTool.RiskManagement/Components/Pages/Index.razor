@page "/"

<PageTitle>@Title</PageTitle>

<h1 class="govuk-heading-l">@Title</h1>

<GdsSpinner Show="_isLoading" ShowMessage="true" />


<EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="TopSearch">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <FloodOnlineReportingTool.RiskManagement.Components.Search.Searchbox For="@(() => Model.SearchText)" LabelText="Some Text"></FloodOnlineReportingTool.RiskManagement.Components.Search.Searchbox>

</EditForm>

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <FloodOnlineReportingTool.RiskManagement.Components.Layout.GridCard CardSize="OneHalf" BodyText="Flood searches saved in the last 30 days" HeaderText="4"></FloodOnlineReportingTool.RiskManagement.Components.Layout.GridCard>
        <FloodOnlineReportingTool.RiskManagement.Components.Layout.GridCard CardSize="OneHalf" BodyText="Flood events recorded in the last 30 days" HeaderText="2"></FloodOnlineReportingTool.RiskManagement.Components.Layout.GridCard>
    </div>
    <div class="govuk-grid-row">
        <FloodOnlineReportingTool.RiskManagement.Components.Layout.GridCard CardSize="OneHalf" BodyText="Action waiting for you" HeaderText="1"></FloodOnlineReportingTool.RiskManagement.Components.Layout.GridCard>
        <FloodOnlineReportingTool.RiskManagement.Components.Layout.GridCard CardSize="OneHalf" BodyText="Create a new property search" HeaderText="Property Searches"></FloodOnlineReportingTool.RiskManagement.Components.Layout.GridCard>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <h3>Other tasks</h3>

            <ul class="govuk-list">
                <li>
                    <a class="govuk-link" href="#">Create a new flood event</a>
                </li>
                <li>
                    <a class="govuk-link" href="#">Create a property log / record site visits</a>
                </li>
            </ul>

        </div>
        <div class="govuk-grid-column-one-half">
            <h3>Pick up where you left off</h3>

            <ul class="govuk-list">
                <li>
                    <a class="govuk-link" href="#">Recent page 1</a>
                </li>
                <li>
                    <a class="govuk-link" href="#">Recent page 2</a>
                </li>
            </ul>
        </div>
    </div>
</div>