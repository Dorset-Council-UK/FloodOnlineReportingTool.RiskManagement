@page "/event/{Reference}"

@using FloodOnlineReportingTool.RiskManagement.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Flood Event Details</PageTitle>
<GdsBreadcrumbs Items="Breadcrumbs" />

<GdsHeading Level="2">View flood event summary</GdsHeading>

<AuthorizeView Policy="@PolicyNames.Reader">
    <Authorized>
        @if (_redirectingToSearchOptions)
        {
            <GdsSpinner Show ShowMessage Message="Redirecting to search options..." />
        }
        else if (ViewModel is null)
        {
            <GdsWarning Text="We couldn't load the data for this record." />
        }
        else
        {
            <GdsGridRow AdditionalCssClasses="govuk-!-margin-bottom-2">
                <GdsGridColumn Width="GdsGridColumnWidth.TwoThirds" AdditionalCssClasses="print-main-column">

                    @* TODO - add action buttons functionality once decided *@
                    <div class="govuk-button-group">
                        <GdsButton IsSubmit="false" Text="Action 1" AdditionalCssClasses="govuk-button--secondary no-print" />
                        <GdsButton IsSubmit="false" Text="Action 2" AdditionalCssClasses="govuk-button--secondary no-print" />
                        <GdsButton IsSubmit="false" Text="Action 3" AdditionalCssClasses="govuk-button--secondary no-print" />
                    </div>

                    <GdsHeading Level="3">Basic details</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Reference
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Reference
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Title
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.SearchTitle
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Created on
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.CreatedAt.GdsReadable()
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Updated on
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @if (ViewModel.UpdatedAt == default)
                                {
                                    <span>-</span>
                                }
                                else if (string.IsNullOrWhiteSpace(ViewModel.UpdatedBy))
                                {
                                    <span>@ViewModel.UpdatedAt.GdsReadable()</span>
                                }
                                else
                                {
                                    <span>@ViewModel.UpdatedAt.GdsReadable() by @ViewModel.UpdatedBy</span>
                                }
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Record status
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.RecordStatus
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood status
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.FloodStatus
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Investigation status
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.InvestigationStatus
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="3">About the flood</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood cause
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @if (ViewModel.PrimaryFloodCauses.Any() || ViewModel.SecondaryFloodCauses.Any())
                                {
                                    <ul class="govuk-list govuk-list--bullet">
                                        @foreach (var cause in ViewModel.PrimaryFloodCauses)
                                        {
                                            <li>@cause (Primary)</li>
                                        }
                                        @foreach (var cause in ViewModel.SecondaryFloodCauses)
                                        {
                                            <li>@cause (Secondary)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood start date
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @(ViewModel.FloodingStart == default ? "-" : ViewModel.FloodingStart.GdsReadable())
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood end date
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.FloodingEnd.GdsReadable()
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="3">Organisations</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Lead organisation
                            </dt>
                            <dd class="govuk-summary-list__value">
                                <ul class="govuk-list govuk-list--bullet">
                                    @if (ViewModel.ResponsibleOrganisations.Any())
                                    {
                                        @foreach (var organisation in ViewModel.ResponsibleOrganisations)
                                        {
                                            <li>@organisation</li>
                                        }
                                    } else
                                    {
                                        <li>Unknown</li>
                                    }
                                </ul>
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="3">Total Estimated Impacts</GdsHeading>
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Property type</th>
                                <th scope="col" class="govuk-table__header">Flooded</th>
                                <th scope="col" class="govuk-table__header">Affected</th>
                                <th scope="col" class="govuk-table__header">Other</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Residential</th>
                                <td class="govuk-table__cell">@ViewModel.EstimatedResidentialFlooded</td>
                                <td class="govuk-table__cell">@ViewModel.EstimatedResidentialAffected</td>
                                <td class="govuk-table__cell">@ViewModel.EstimatedResidentialOther</td>
                            </tr>
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Commercial</th>
                                <td class="govuk-table__cell">@ViewModel.EstimatedCommercialFlooded</td>
                                <td class="govuk-table__cell">@ViewModel.EstimatedCommercialAffected</td>
                                <td class="govuk-table__cell">@ViewModel.EstimatedCommercialOther</td>
                            </tr>
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Total</th>
                                <td class="govuk-table__cell">@ViewModel.EstimatedTotalInternallyFlooded</td>
                                <td class="govuk-table__cell" colspan="2">@ViewModel.EstimatedTotalExternalOnly</td>
                            </tr>
                        </tbody>
                    </table>

                    <p><a href="event/propertysummary/@Reference">Full details for all affected properties</a></p>

                    <GdsHeading Level="3">Location</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                UPRN/USRN
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @if (ViewModel.UPRN is null && ViewModel.USRN is null)
                                {
                                    <span>Not provided</span>
                                }
                                else
                                {
                                    @if (ViewModel.UPRN is not null)
                                    {
                                        <div>UPRN: @ViewModel.UPRN</div>
                                    }
                                    @if (ViewModel.USRN is not null)
                                    {
                                        <div>USRN: @ViewModel.USRN</div>
                                    }
                                }
                            </dd>
                        </div>
                    </dl>
                    <div style="height:300px;" class="govuk-!-margin-bottom-2">
                        <MiniMap Geometry=ViewModel.Geom></MiniMap>
                    </div>

                </GdsGridColumn>

                <GdsGridColumn Width="GdsGridColumnWidth.OneThird" AdditionalCssClasses="no-print">

                    <GdsHeading Level="4">Further details</GdsHeading>
                    <p><GdsLink Href="@($"event/propertysummary/{Reference}")">Affected properties</GdsLink></p>
                    <p><GdsLink Href="@($"event/impactsummary/{Reference}")">Flood impacts</GdsLink></p>
                    <p><GdsLink Href="@($"event/attachments/{Reference}")">Attachments</GdsLink></p>
                    <p><GdsLink Href="@($"event/comments/{Reference}")">Comments</GdsLink></p>
                    <hr class="govuk-section-break govuk-section-break--m" />

                    <GdsHeading Level="4">Download the data</GdsHeading>
                    <p><GdsLink Href="@_selfUrl" OnClick="PrintPageAsync" PreventDefault>Print/Save page</GdsLink></p>
                    <p><GdsLink Href="@ExportToCsv()" AdditionalAttributes="@(new Dictionary<string, object> { { "download", CsvDownloadFileName } })">CSV</GdsLink></p>
                    <p><GdsLink Href="@ExportToJson()" AdditionalAttributes="@(new Dictionary<string, object> { { "download", JsonDownloadFileName } })">GeoJSON</GdsLink></p>

                </GdsGridColumn>
            </GdsGridRow>

        }
    </Authorized>

    <NotAuthorized>
        <GdsWarning Text="You do not have permission to view events. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>
