@page "/event/{Reference}"

@using FloodOnlineReportingTool.RiskManagement.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Flood Event Details</PageTitle>
<GdsBreadcrumbs Items="Breadcrumbs" />

<GdsHeading Level="1">View flood event summary</GdsHeading>

<AuthorizeView Policy="@PolicyNames.Reader">
    <Authorized>
        @if (_isLoading)
        {
            <GdsSpinner Show ShowMessage Message="Loading data" />
        }
        else if (ViewModel is null)
        {
            <GdsWarning Text="We couldn't load the data for this record." />
        }
        else
        {
            <GdsGridRow AdditionalCssClasses="govuk-!-margin-bottom-2">
                <GdsGridColumn Width="GdsGridColumnWidth.TwoThirds" AdditionalCssClasses="print-main-column">

                    @* TODO - add action buttons functionality once decided *@
                    <div class="govuk-button-group">
                        @if (_canWrite && string.IsNullOrEmpty(ViewModel.MediaReference))
                        {
                            <GdsButton IsSubmit="false" Text="Generate Public Upload URL" AdditionalCssClasses="govuk-button--secondary no-print" OnClick="CreatePublicMediaUrl" />
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(ViewModel.MediaReference))
                    {
                        if (DateTimeOffset.UtcNow <= ViewModel.MediaReferenceExpiration)
                        {
                            <GdsNotificationBanner NotificationType="GdsNotificationBanner.NotificationTypeOption.info"
                                                   BannerHeadingLevel="2"
                                                   BannerTitle="Public upload available">
                                <p class="govuk-body">
                                    Public upload available until @(ViewModel.MediaReferenceExpiration.GdsReadable()).
                                </p>
                                @if (ViewModel.MediaUploadLock)
                                {
                                    <GdsWarning Text="This upload is currently locked"></GdsWarning>
                                }
                                else
                                {
                                    <p class="govuk-body">
                                        <GdsLink Href="@GetMediaUrl()" target="_blank" rel="noopener noreferrer">@GetDisplayMediaUrl()</GdsLink>
                                    </p>
                                    @if (!_showMediaUrlQrCode)
                                    {
                                        <p class="govuk-body">
                                            <GdsLink Href="#" OnClick="ShowMediaUrlQrCode" PreventDefault>Show QR code for this link</GdsLink>
                                        </p>
                                    }
                                    @if (_showMediaUrlQrCode && !string.IsNullOrWhiteSpace(_mediaUrlQrCodeDataUrl))
                                    {
                                        <p class="govuk-body govuk-!-margin-bottom-2">QR code for the public link:</p>
                                        <img src="@_mediaUrlQrCodeDataUrl" alt="QR code for public media upload link" width="180" height="180" />
                                    }
                                }
                                @if (_canWrite)
                                {
                                    <div class="govuk-button-group">
                                        <GdsButton IsSubmit="false"
                                                   Text="@GetMediaUploadLockButtonText()"
                                                   AdditionalCssClasses="no-print"
                                                   OnClick="ToggleMediaUploadLock" />
                                    </div>
                                }
                            </GdsNotificationBanner>
                        } else
                        {
                            <GdsNotificationBanner NotificationType="GdsNotificationBanner.NotificationTypeOption.info"
                                                   BannerHeadingLevel="2"
                                                   BannerTitle="Public upload expired">
                                <GdsWarning Text="This upload has expired"></GdsWarning>
                                @if (_canWrite)
                                {
                                    <GdsFormGroup>
                                        <GdsLabel Text="Extend by weeks" />
                                        <GdsInputNumber @bind-Value="_mediaUrlExtensionWeeksText"
                                                        @bind-NumberValue="_mediaUrlExtensionWeeks"
                                                        class="govuk-input govuk-input--width-3" />
                                    </GdsFormGroup>
                                    @if (!string.IsNullOrWhiteSpace(_mediaUrlExtensionError))
                                    {
                                        <GdsWarning Text="@_mediaUrlExtensionError" />
                                    }
                                    <div class="govuk-button-group">
                                        <GdsButton IsSubmit="false"
                                                   Text="Extend public upload URL"
                                                   AdditionalCssClasses="no-print"
                                                   OnClick="ExtendMediaUrlExpiry" />
                                    </div>
                                }
                            </GdsNotificationBanner>
                        }
                    }

                    <GdsHeading Level="2">Basic details</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Reference
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Reference
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Title
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.SearchTitle
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Created on
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.CreatedAt.GdsReadable()
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Updated on
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @if (ViewModel.UpdatedAt == default)
                                {
                                    <span>-</span>
                                }
                                else if (string.IsNullOrWhiteSpace(ViewModel.UpdatedBy))
                                {
                                    <span>@ViewModel.UpdatedAt.GdsReadable()</span>
                                }
                                else
                                {
                                    <span>@ViewModel.UpdatedAt.GdsReadable() by @ViewModel.UpdatedBy</span>
                                }
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Record status
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.RecordStatus
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood status
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.FloodStatus
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Investigation status
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.InvestigationStatus
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="2">About the flood</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood cause
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @if (ViewModel.PrimaryFloodCauses.Any() || ViewModel.SecondaryFloodCauses.Any())
                                {
                                    <ul class="govuk-list govuk-list--bullet">
                                        @foreach (var cause in ViewModel.PrimaryFloodCauses)
                                        {
                                            <li>@cause (Primary)</li>
                                        }
                                        @foreach (var cause in ViewModel.SecondaryFloodCauses)
                                        {
                                            <li>@cause (Secondary)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood start date
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @(ViewModel.FloodingStart == default ? "-" : ViewModel.FloodingStart.GdsReadable())
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Flood end date
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @ViewModel.FloodingEnd.GdsReadable()
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="2">Organisations</GdsHeading>
                    <dl class="govuk-summary-list page-break">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                Lead organisation
                            </dt>
                            <dd class="govuk-summary-list__value">
                                <ul class="govuk-list govuk-list--bullet">
                                    @if (ViewModel.ResponsibleOrganisations.Any())
                                    {
                                        @foreach (var organisation in ViewModel.ResponsibleOrganisations)
                                        {
                                            <li>@organisation</li>
                                        }
                                    } else
                                    {
                                        <li>Unknown</li>
                                    }
                                </ul>
                            </dd>
                        </div>
                    </dl>

                    <GdsHeading Level="2">Total Estimated Impacts</GdsHeading>
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Property type</th>
                                <th scope="col" class="govuk-table__header">Flooded</th>
                                <th scope="col" class="govuk-table__header">Affected</th>
                                <th scope="col" class="govuk-table__header">Other</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Residential</th>
                                <td class="govuk-table__cell">@ViewModel.EstimatedResidentialFlooded</td>
                                <td class="govuk-table__cell">@ViewModel.EstimatedResidentialAffected</td>
                                <td class="govuk-table__cell">@ViewModel.EstimatedResidentialOther</td>
                            </tr>
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Commercial</th>
                                <td class="govuk-table__cell">@ViewModel.EstimatedCommercialFlooded</td>
                                <td class="govuk-table__cell">@ViewModel.EstimatedCommercialAffected</td>
                                <td class="govuk-table__cell">@ViewModel.EstimatedCommercialOther</td>
                            </tr>
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Total</th>
                                <td class="govuk-table__cell">@ViewModel.EstimatedTotalInternallyFlooded</td>
                                <td class="govuk-table__cell" colspan="2">@ViewModel.EstimatedTotalExternalOnly</td>
                            </tr>
                        </tbody>
                    </table>

                    @* TODO - uncomment affected property link once functionality built *@
                    @*<p><GdsLink Href="@($"event/propertysummary/{Reference}")">Full details for all affected properties</GdsLink></p>*@

                    <GdsHeading Level="2">Location</GdsHeading>
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                                UPRN/USRN
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @if (ViewModel.UPRN is null && ViewModel.USRN is null)
                                {
                                    <span>Not provided</span>
                                }
                                else
                                {
                                    @if (ViewModel.UPRN is not null)
                                    {
                                        <div>UPRN: @ViewModel.UPRN</div>
                                    }
                                    @if (ViewModel.USRN is not null)
                                    {
                                        <div>USRN: @ViewModel.USRN</div>
                                    }
                                }
                            </dd>
                        </div>
                    </dl>                    
                    <div style="height:300px;" class="govuk-!-margin-bottom-2">
                        <MiniMap Geometry=ViewModel.Geom></MiniMap>
                    </div>

                </GdsGridColumn>

                <GdsGridColumn Width="GdsGridColumnWidth.OneThird" AdditionalCssClasses="no-print">

                    <GdsHeading Level="2" Size="GdsSize.Medium">Further details</GdsHeading>
                    @* TODO - uncomment affected property link once functionality built *@
                    @* <p><GdsLink Href="@($"event/propertysummary/{Reference}")">Affected properties</GdsLink></p> *@
                    @* TODO - uncomment flood impacts link once functionality built *@
                    @* <p><GdsLink Href="@($"event/impactsummary/{Reference}")">Flood impacts</GdsLink></p> *@
                    <p><GdsLink Href="@($"event/attachments/{Reference}")">Attachments</GdsLink></p>
                    @* TODO - uncomment comments link once functionality built *@
                    @* <p><GdsLink Href="@($"event/comments/{Reference}")">Comments</GdsLink></p> *@
                    <hr class="govuk-section-break govuk-section-break--m" />

                    <GdsHeading Level="2" Size="GdsSize.Medium">Download the data</GdsHeading>
                    @if (!string.IsNullOrEmpty(_exportErrorMessage))
                    {
                        <GdsWarning Text="@_exportErrorMessage" />
                    }
                    <p><GdsLink Href="@SelfUrl" OnClick="PrintPageAsync" PreventDefault>Print/Save page</GdsLink></p>
                    <p><button class="govuk-link" @onclick="ExportToCsv" disabled="@_isExportingCsv"><span class="govuk-visually-hidden">Download </span>CSV</button></p>
                    @if (ViewModel.Geom is not null && ViewModel.Geom.NumGeometries is not 0)
                    {
                        <p><button class="govuk-link" @onclick="ExportToJson" disabled="@_isExportingJson"><span class="govuk-visually-hidden">Download </span>GeoJSON</button></p>
                    }

                </GdsGridColumn>
            </GdsGridRow>

        }
    </Authorized>

    <NotAuthorized>
        <GdsWarning Text="You do not have permission to view events. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>