@page "/event/details/{SearchReference}"
@page "/event/details/{SearchReference}/{Overview:bool}"
@page "/event/details"
@using FloodOnlineReportingTool.Contracts.Shared
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using FloodOnlineReportingTool.RiskManagement.Models.Order
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Flood Event Details</PageTitle>

<GdsHeading Level="1" Size="GdsSize.Large">Flood Event Details</GdsHeading>

<GdsBackLink Href="@($"{SearchPages.Results.Url}/{SearchReference}")" />

@if (!Overview)
{
    <p class="govuk-body-l">
        This form will upgrade a search to a flood event.
    </p>
}

<AuthorizeView Policy="@PolicyNames.Writer" Context="authContext">
    <Authorized>
        @if (_redirectingToSearchOptions)
        {
            <GdsSpinner Show ShowMessage Message="Redirecting to search options..." />
        }
        else if (EditContext is not null)
        {
            <EditForm EditContext="EditContext" OnValidSubmit="OnValidSubmit" FormName="CreateEventForm">
                <FluentValidationValidator />
                <GdsErrorSummary />
            
                <GdsFormGroup>
                    <GdsFieldsetGroup>
                        <GdsFieldsetLegend Size="GdsSize.Medium">
                            <GdsFieldsetHeading Level="2">Flood Event Details</GdsFieldsetHeading>
                        </GdsFieldsetLegend>

                        <GdsFormGroup>
                            <GdsLabel Text="Flood event name" />
                            <GdsHint>This should be descriptive - such as 2026 From-Until PlaceName Flooding Type.</GdsHint>
                            <GdsErrorMessage />
                            <GdsInputText @bind-Value=Model.SearchTitle class="govuk-input" />
                        </GdsFormGroup>  
                    </GdsFieldsetGroup>
                </GdsFormGroup>

                <GdsFormGroup>
                    <GdsFieldsetGroup>
                        <GdsGridRow>
                            <GdsGridColumn Width="GdsGridColumnWidth.OneThird">
                                <GdsFormGroup>
                                    <GdsLabel Text="Record status:" />
                                    <GdsSelect T="Guid" @bind-Value="Model.RecordStatus" style="width:100%;">
                                        @foreach (var option in _eventStatuses)
                                        {
                                            <option value="@option.Id">@option.Text</option>
                                        }
                                    </GdsSelect>
                                    <GdsErrorMessage />
                                </GdsFormGroup>
                            </GdsGridColumn>

                            <GdsGridColumn Width="GdsGridColumnWidth.OneThird">
                                <GdsFormGroup>
                                    <GdsLabel Text="Flood status:" />
                                    <GdsSelect T="Guid" @bind-Value="Model.FloodStatus" style="width:100%;">
                                        @foreach(var option in _floodStatuses)
                                        {
                                            <option value="@option.Id">@option.Text</option>
                                        }
                                    </GdsSelect>
                                    <GdsErrorMessage />
                                </GdsFormGroup>
                            </GdsGridColumn>

                            <GdsGridColumn Width="GdsGridColumnWidth.OneThird">
                                <GdsFormGroup>
                                    <GdsLabel Text="Investigation status:" />
                                    <GdsSelect T="Guid" @bind-Value="Model.InvestigationStatus" style="width:100%;">
                                        @foreach (var option in _investigationStatuses)
                                        {
                                            <option value="@option.Id">@option.Text</option>
                                        }
                                    </GdsSelect>
                                    <GdsErrorMessage />
                                </GdsFormGroup>
                            </GdsGridColumn>

                        </GdsGridRow>
                    </GdsFieldsetGroup>
                </GdsFormGroup>

                <GdsFormGroup>
                    <GdsFieldsetGroup>
                        <GdsFieldsetLegend Size="GdsSize.Medium">
                            <GdsFieldsetHeading Level="2">Estimated Totals</GdsFieldsetHeading>
                        </GdsFieldsetLegend>
                        <GdsGridRow>
                            <GdsGridColumn Width="GdsGridColumnWidth.OneThird">
                                <GdsFormGroup>
                                    <GdsLabel Text="Internally flooded:" />
                                    <GdsInputNumber @bind-Value=Model.EstimatedTotalInternallyFloodedString @bind-NumberValue=Model.EstimatedTotalInternallyFlooded class="govuk-input govuk-input-width--10" />
                                    <GdsErrorMessage />
                                </GdsFormGroup>
                            </GdsGridColumn>

                            <GdsGridColumn Width="GdsGridColumnWidth.OneThird">
                                <GdsFormGroup>
                                    <GdsLabel Text="External only (Affected):" />
                                    <GdsInputNumber @bind-Value=Model.EstimatedTotalExternalOnlyString @bind-NumberValue=Model.EstimatedTotalExternalOnly class="govuk-input govuk-input-width--10" />
                                    <GdsErrorMessage />
                                </GdsFormGroup>
                            </GdsGridColumn>

                            <GdsGridColumn Width="GdsGridColumnWidth.OneThird">
                                <GdsFormGroup>
                                    <GdsLabel Text="Without utilities:" />
                                    <GdsInputNumber @bind-Value=Model.EstimatedDisruptedUtilitiesString @bind-NumberValue=Model.EstimatedDisruptedUtilities class="govuk-input govuk-input-width--10" />
                                    <GdsErrorMessage />
                                </GdsFormGroup>
                            </GdsGridColumn>

                        </GdsGridRow>
                    </GdsFieldsetGroup>
                </GdsFormGroup>

                <GdsFormGroup>
                    <GdsFieldsetGroup>
                        <GdsGridRow>
                            <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                                <GdsFormGroup>
                                    <GdsLabel Text="Vulnerable persons:" />
                                    <GdsInputNumber @bind-Value=Model.EstimatedVulnerableString @bind-NumberValue=Model.EstimatedVulnerable class="govuk-input govuk-input-width--10" />
                                    <GdsErrorMessage />
                                </GdsFormGroup>
                            </GdsGridColumn>

                            <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                                <GdsFormGroup>
                                    <GdsLabel Text="Uninhabitable properties:" />
                                    <GdsInputNumber @bind-Value=Model.EstimatedUninhabitableString @bind-NumberValue=Model.EstimatedUninhabitable class="govuk-input govuk-input-width--10" />
                                    <GdsErrorMessage />
                                </GdsFormGroup>
                            </GdsGridColumn>
                        </GdsGridRow>
                    </GdsFieldsetGroup>
                </GdsFormGroup>

                <GdsFormGroup>
                    <GdsFieldsetGroup>
                        <GdsFormGroup>
                            <GdsLabel Text="Status notes (optional):" />
                            <GdsHint>This is a general comment about the flooding status and where the information about the event has come from.</GdsHint>
                            <GdsErrorMessage />
                            <textarea class="govuk-textarea" @bind=Model.StatusNote rows="5" aria-describedby="more-detail-hint"></textarea>
                        </GdsFormGroup>
                    </GdsFieldsetGroup>
                </GdsFormGroup>

                @if (Model.InvestigationStatus == Section19StatusIds.Section19Included)
                {
                    <GdsWarning Icon="!" Text="Report completed! This will lock associated reports if not already done." />
                }
                else if (Model.InvestigationStatus != Section19StatusIds.NoSection19)
                {
                    <GdsWarning Icon="!" Text="This will trigger a request for residents to complete the investigation form." />
                } 

                <div class="govuk-button-group">
                    <GdsButton IsSubmit="true" Text="Save flood event" />
                    <GdsButton IsSubmit="false" OnClick="@GoToEstimates" AdditionalCssClasses="govuk-button--secondary" Text="Add detailed estimates" />
                    <GdsButton IsSubmit="false" OnClick="@GoToUpload" AdditionalCssClasses="govuk-button--secondary" Text="Upload attachments" />
                </div>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <GdsWarning Text="You do not have permission to create flood events. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>