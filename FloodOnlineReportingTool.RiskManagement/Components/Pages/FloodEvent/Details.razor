@page "/event/details/{SearchReference}"
@page "/event/details"
@using FloodOnlineReportingTool.Contracts.Shared
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using FloodOnlineReportingTool.RiskManagement.Models.Order
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Flood Event Details</PageTitle>

<h1 class="govuk-heading-l">Flood Event Details</h1>

<GdsBackLink Href="@($"{SearchPages.Results.Url}/{SearchReference}")"></GdsBackLink>

<p class="govuk-body-l">
    This form will upgrade a search to a flood event. 
</p>

<!--<AuthorizeView Policy="@PolicyNames.Writer" Context="authContext">-->
<AuthorizeView Context="authContext">
    <Authorized>
        <EditForm EditContext="eventContext" OnValidSubmit="OnValidSubmit" FormName="CreateEventForm">
            <FluentValidationValidator />
            <GdsErrorSummary />
            <GdsSpinner Show="_isLoading" ShowMessage="true" />
            
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">Flood Event Details</h2>
                    </legend>

                    <GdsFormGroup For="() => Model.SearchTitle">
                        <GdsLabel Text="Flood Event Name" />
                        <GdsHint>This should be descriptive i.e. 2026 From-Until PlaceName Flooding Type.</GdsHint>
                        <GdsErrorMessage />
                        <GdsInputText @bind-Value=Model.SearchTitle class="govuk-input" />
                    </GdsFormGroup>  
                </fieldset>
            </div>
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.RecordStatus">
                                <GdsLabel Text="Record Status:" />
                                <GdsErrorMessage />
                                @if (_eventStatuses != null)
                                {
                                    <GdsSelect T="Guid" @bind-value="Model.RecordStatus" style="width:100%;" Options="_eventStatuses" OnChange="@OnEventStatusChange" />
                                }
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.FloodStatus">
                                <GdsLabel Text="Flood Status:" />
                                <GdsErrorMessage />
                                @if (_floodStatuses != null)
                                {
                                    <GdsSelect T="Guid" @bind-value="Model.FloodStatus" style="width:100%;" Options="_floodStatuses" OnChange="@OnFloodStatusChange" />
                                }
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.InvestigationStatus">
                                <GdsLabel Text="Investigation Status:" />
                                <GdsErrorMessage />
                                @if (_investigationStatuses != null)
                                {
                                    <GdsSelect T="Guid" @bind-value="Model.InvestigationStatus" style="width:100%;" Options="_investigationStatuses" OnChange="@OnInvestigationStatusChange" />
                                }
                            </GdsFormGroup>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-half">
                            <GdsFormGroup For="() => Model.EstimatedTotalInternallyFlooded">
                                <GdsLabel Text="Estimated Internally Flooded:" />
                                <GdsErrorMessage />
                                <GdsInputNumber @bind-Value=Model.EstimatedTotalInternallyFloodedString @bind-NumberValue=Model.EstimatedTotalInternallyFlooded class="govuk-input govuk-input-width--10" />
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-half">
                            <GdsFormGroup For="() => Model.EstimatedUninhabitable">
                                <GdsLabel Text="Estimated Uninhabitable:" />
                                <GdsErrorMessage />
                                <GdsInputNumber @bind-Value=Model.EstimatedUninhabitableString @bind-NumberValue=Model.EstimatedUninhabitable class="govuk-input govuk-input-width--10" />
                            </GdsFormGroup>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-half">
                            <GdsFormGroup For="() => Model.EstimatedVulnerable">
                                <GdsLabel Text="Estimated Vulnerable:" />
                                <GdsErrorMessage />
                                <GdsInputNumber @bind-Value=Model.EstimatedVulnerableString @bind-NumberValue=Model.EstimatedVulnerable class="govuk-input govuk-input-width--10" />
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-half">
                            <GdsFormGroup For="() => Model.EstimatedTotalExternalOnly">
                                <GdsLabel Text="Estimated External Only (Affected):" />
                                <GdsErrorMessage />
                                <GdsInputNumber @bind-Value=Model.EstimatedTotalExternalOnlyString @bind-NumberValue=Model.EstimatedTotalExternalOnly class="govuk-input govuk-input-width--10" />
                            </GdsFormGroup>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <GdsFormGroup For="() => Model.StatusNote">
                        <GdsLabel Text="Status Notes (optional):" />
                        <GdsHint>This is a general comment about the flooding status and where the information about the event has come from.</GdsHint>
                        <GdsErrorMessage />
                        <textarea class="govuk-textarea" @bind=Model.StatusNote rows="5" aria-describedby="more-detail-hint"></textarea>
                    </GdsFormGroup>
                </fieldset>
            </div>

            @if (Model.InvestigationStatus == Section19StatusIds.Section19Included)
            {
                <GdsWarning Icon="!" Text="Report completed! This will lock associated reports if not already done." />
            }
            else if (Model.InvestigationStatus != Section19StatusIds.NoSection19)
            {
                <GdsWarning Icon="!" Text="This will trigger a request for residents to complete the investigation form." />
            } 

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    @if (!_isLoading)
                    {
                        <div class="govuk-button-group">
                            <GdsButton IsSubmit="true" Text="Save flood event" />
                            <GdsButton IsSubmit="false" OnClick="@GoToEstimates" AdditionalCssClasses="govuk-button--secondary" Text="Add detailed estimates" />
                        </div>
                    }
                </fieldset>
            </div>

        </EditForm>
    </Authorized>
    <NotAuthorized>
        <GdsWarning Text="You do not have permission to create flood events. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>