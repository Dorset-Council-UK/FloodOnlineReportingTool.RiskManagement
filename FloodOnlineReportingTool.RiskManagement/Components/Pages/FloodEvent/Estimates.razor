@page "/event/estimates/{SearchReference}"
@page "/event/estimates"

@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Event Impact Estimates</PageTitle>

<h1 class="govuk-heading-l">Event Impact Estimates</h1>

<p class="govuk-body-l">
    Add the estimated impacts for this flood event.
</p>

<!--<AuthorizeView Policy="@PolicyNames.Writer" Context="authContext">-->
<AuthorizeView Context="authContext">
    <Authorized>
        <EditForm EditContext="EditContext" OnValidSubmit="OnValidSubmit" FormName="CreateEventForm">
            <FluentValidationValidator />
            <GdsErrorSummary />
            <GdsSpinner Show="_isLoading" ShowMessage="true" />
            <GdsInsetText>
                <p>
                    The maximum permitted:
                    <ul>
                        <li>Internally flooded: @Model.EstimatedTotalInternallyFlooded</li>
                        <li>Affected: @Model.EstimatedTotalExternalOnly</li>
                    </ul>
                </p>
            </GdsInsetText>
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">Residential</h2>
                    </legend>
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.EstimatedResidentialFloodedString">
                                <GdsLabel Text="Internally flooded:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedResidentialFloodedString @bind-NumberValue=Model.EstimatedResidentialFlooded class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.EstimatedResidentialAffectedString">
                                <GdsLabel Text="Affected:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedResidentialAffectedString @bind-NumberValue=Model.EstimatedResidentialAffected class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.EstimatedResidentialOtherString">
                                <GdsLabel Text="Other:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedResidentialOtherString @bind-NumberValue=Model.EstimatedResidentialOther class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">Commercial</h2>
                    </legend>
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.EstimatedCommercialFloodedString">
                                <GdsLabel Text="Internally flooded:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedCommercialFloodedString @bind-NumberValue=Model.EstimatedCommercialFlooded class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.EstimatedCommercialAffectedString">
                                <GdsLabel Text="Affected:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedCommercialAffectedString @bind-NumberValue=Model.EstimatedCommercialAffected class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-third">
                            <GdsFormGroup For="() => Model.EstimatedCommercialOtherString">
                                <GdsLabel Text="Other:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedCommercialOtherString @bind-NumberValue=Model.EstimatedCommercialOther class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                    </div>
                </fieldset>
            </div>

            <GdsInsetText>
                <p>
                    The maximum permitted:
                    <ul>
                        <li>Disrupted Utilities: @Model.EstimatedDisruptedUtilities</li>
                    </ul>
                </p>
            </GdsInsetText>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">Utility Impacts</h2>
                    </legend>
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-half">
                            <GdsFormGroup For="() => Model.EstimatedNoElectricString">
                                <GdsLabel Text="Switched off electrics:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedNoElectricString @bind-NumberValue=Model.EstimatedNoElectric class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-half">
                            <GdsFormGroup For="() => Model.EstimatedNoGasString">
                                <GdsLabel Text="Switched off gas:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedNoGasString @bind-NumberValue=Model.EstimatedNoGas class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-half">
                            <GdsFormGroup For="() => Model.EstimatedNoFoulString">
                                <GdsLabel Text="Foul sewer unavailable:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedNoFoulString @bind-NumberValue=Model.EstimatedNoFoul class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                        <div class="govuk-grid-column-one-half">
                            <GdsFormGroup For="() => Model.EstimatedNoWaterSupplyString">
                                <GdsLabel Text="Water supply unavailable:" />
                                <GdsInputNumber @bind-Value=Model.EstimatedNoWaterSupplyString @bind-NumberValue=Model.EstimatedNoWaterSupply class="govuk-input govuk-input-width--10" />
                                <GdsErrorMessage />
                            </GdsFormGroup>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            @if (!_isLoading)
                            {
                                <div class="govuk-button-group">
                                    <GdsButton IsSubmit="true" Text="Save flood event" />
                                    <GdsButton IsSubmit="false" OnClick="@BackToDetails" AdditionalCssClasses="govuk-button--secondary" Text="Return to details" />
                                </div>
                                
                            }
                        </div>
                    </div>
                </fieldset>
            </div>
        </EditForm>
    </Authorized>
    <NotAuthorized>
        <GdsWarning Text="You do not have permission to create flood events. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>
