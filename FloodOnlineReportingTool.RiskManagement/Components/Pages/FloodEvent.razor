@page "/flood-event"

<PageTitle>Create a flood event</PageTitle>
<GdsBreadcrumbs Items="Breadcrumbs" />

<h1 class="govuk-heading-xl">Create a flood event</h1>

<EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="FloodEvent">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsFormGroup For="() => Model!.Something">
        <GdsLabel Text="Temp Id" AdditionalCssClasses="govuk-label--m" />
        <GdsErrorMessage />
        <GdsInputText @bind-Value=Model!.Something class="govuk-input" />
    </GdsFormGroup>

    @* TODO - add in map *@
    <GdsFormGroup For="@(() => Model)">
        <GdsErrorMessage />
        <GdsLabel Text="Draw the extent of the flood" AdditionalCssClasses="govuk-label--m" />
        <img src="https://imageplaceholder.net/800x400/eeeeee/131313?text=Map+here" />
    </GdsFormGroup> 

    <p><button type="submit" data-prevent-double-click="true" class="govuk-button" data-module="govuk-button">Continue</button></p>
</EditForm>
