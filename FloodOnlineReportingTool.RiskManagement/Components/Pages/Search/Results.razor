@page "/search/results/{SearchReference}"
@page "/search/results"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using FloodOnlineReportingTool.RiskManagement.Models.Order
@using FloodOnlineReportingTool.RiskManagement.Models.Search
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Search Results</PageTitle>

<GdsBackLink Href="@($"{SearchPages.Options.Url}/{SearchReference}")"></GdsBackLink>

<GdsHeading Level="1" Size="GdsSize.Large">Results for Search @SearchReference</GdsHeading>

<p>You can use the reference to get straight back to these results at any time.</p>

<AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
    <Authorized>
        <GdsSpinner Show="_isLoading" ShowMessage="true" />

        @if (_gettingToken)
        {
            <p>Please wait whilst we authenticate you...</p>
        }
        else if (SearchResults is null && !_isLoading)
        {
            <p>Sorry, something went wrong. We were unable to load the results</p>
        } else
        {
            if (!_isLoading && (SearchResults is not null && SearchResults.TotalCount != 0))
            {
                <GdsTabs Title="View results as">

                    <GdsTabPanel Heading="Table" Id="table">
                    
                        @if (SearchResultsGrouped is not null)
                        {
                            <SearchResultTable SearchResults="SearchResultsGrouped" OnPageChanged="(int p) => OnPageChanged(p)" />
                        }
                    </GdsTabPanel>

                    <GdsTabPanel Heading="List" Id="list">
                        <SearchResultList SearchResults="SearchResultsGrouped" OnPageChanged="(int pageNumber) => OnPageChanged(pageNumber)" />
                    </GdsTabPanel>

                    <GdsTabPanel Heading="Map" Id="map">
                        <GdsSpinner Show="_isLoadingMapData" ShowMessage="true" />
                        @if (_mapResultsTooMany)
                        {
                            <GdsWarning Text="There are too many results to display on the map. Please refine your search to fewer than 1,000 results." />
                        }
                    
                        <div style="height:400px;" class="govuk-!-margin-bottom-2">
                            <MiniMap @ref="_miniMapRef" OnBecameVisible="OnMapBecameVisible"></MiniMap>
                        </div>
                    </GdsTabPanel>

                </GdsTabs>

                @if (SearchResultsViewModel.FromDate.DateUtc is not null && SearchResultsViewModel.ToDate.DateUtc is not null)
                {
                    <GdsFormGroup>
                        <GdsFieldsetGroup>
                            <GdsGridRow>
                                @if (!_isLoading)
                                {
                                    <details class="govuk-details">
                                        <summary class="govuk-details__summary">
                                            <span class="govuk-details__summary-text">
                                                Why upgrade to a flood event?
                                            </span>
                                        </summary>
                                        <div class="govuk-details__text">
                                            <p class="govuk-body">
                                                This allows you to:
                                            </p>
                                            <ul>
                                                <li>Generate reports into serious flooding (Section 19)</li>
                                                <li>Add estimated impacts</li>
                                                <li>Record actions taken</li>
                                                <li>Enables comment / media functions</li>
                                                <li>Enables public engagement tools</li>
                                            </ul>

                                            <p class="govuk-body">
                                                Reports identified within this search will be asked to complete the investigation form. You must override this default if you wish to defer the action.
                                            </p>
                                        </div>
                                    </details>
                                    <GdsStartButton Href="@($"{EventPages.Details.Url}/{SearchReference}")" Text="Create flood event" />
                                }
                            </GdsGridRow>
                        </GdsFieldsetGroup>
                    </GdsFormGroup>
                }
                

            }
            else if(!_isLoading)
            {
                <NoResultsMessage />
            }
            
        }

    </Authorized>
    <NotAuthorized>
        <GdsWarning Text="You do not have permission to search. Contact your administrator to request permission." />
    </NotAuthorized>
</AuthorizeView>


