@page "/search/options"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using FloodOnlineReportingTool.RiskManagement.Data.Models.Enums
@using FloodOnlineReportingTool.RiskManagement.Models.Search
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBreadcrumbs Items="Breadcrumbs" />
<AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
    <Authorized>
        <EditForm EditContext="searchContext" OnSubmit="OnSubmit" FormName="CreateSearchOptions">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <div class="govuk-width-container">
                <div class="govuk-grid-row">
                    <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">
                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                                <h2 class="govuk-fieldset__heading">Search options</h2>
                            </legend>
                            <div class="govuk-grid-row">
                                <div class="govuk-grid-column-one-half">
                                    <GdsInputDate Id="search-start" For="() => Model.FromDate" Show="!_isLoading">
                                        <Heading>
                                            <GdsLabel For="Model.FromDate" Text="Reports from" />
                                        </Heading>
                                    </GdsInputDate>
                                </div>
                                <div class="govuk-grid-column-one-half">
                                    <GdsInputDate Id="search-end" For="() => Model.ToDate" Show="!_isLoading">
                                        <Heading>
                                            <GdsLabel For="Model.ToDate" Text="Report until" />
                                        </Heading>
                                    </GdsInputDate>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">
                            <div class="govuk-grid-row">
                                <div class="govuk-grid-column-one-half">
                                    <GdsFormGroup For="() => Model.ByPersonsName">
                                        <GdsLabel Text="Search for reports by the person's name" />
                                        <GdsErrorMessage />
                                        <GdsInputText @bind-Value=Model.ByPersonsName class="govuk-input govuk-input--width-50" />
                                    </GdsFormGroup>
                                        </div>
                                    <div class="govuk-grid-column-one-half">
                                    <GdsFormGroup For="() => Model.ByPlaceName">
                                        <GdsLabel Text="Search by affected postcode" />
                                        <GdsErrorMessage />
                                        <GdsInputText @bind-Value=Model.ByPlaceName class="govuk-input govuk-input--width-25" />
                                    </GdsFormGroup>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>

                 <div class="govuk-grid-row">
                    <div class="govuk-form-group">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-one-half">
                                <fieldset class="govuk-fieldset">
                                    <GdsLabel Text="Filter results by the cause of flooding" />
                                    <GdsHint>Select all that apply</GdsHint>
                                    <GdsErrorMessage />
                                    <GdsCheckboxes Smaller="true" Options="_floodSourceOptions" />
                                </fieldset>
                            </div>
                            <div class="govuk-grid-column-one-half">
                                <div style="position: relative; width: 500px; height: 300px;">
                                    <img class="img img-fluid"
                                         src="@_mapURL"
                                         alt="Map showing the selected flood search location or area"
                                         width="500"
                                         height="300"
                                         style="display: block;" />

                                    @if (Model.ByPolygon != null)
                                    {
                                        <svg viewBox="@GetSvgViewBox()"
                                             width="500"
                                             height="300"
                                             style="position: absolute; top: 0; left: 0; pointer-events: none;"
                                             preserveAspectRatio="none">
                                            <polygon points="@GenerateSvgPoints()"
                                                     fill="orange"
                                                     fill-opacity="0.3"
                                                     stroke="orange"
                                                     stroke-width="2" />
                                        </svg>
                                    }
                                </div>
                                <br />
                                <GdsButton IsSubmit="false" AdditionalCssClasses="govuk-button--secondary" OnClick="@GoToMap" Text="Add or modify search area" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="govuk-grid-row">
                    <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">
                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                                <h2 class="govuk-fieldset__heading">Result options</h2>
                            </legend>
                            <div class="govuk-grid-row">
                                <div class="govuk-grid-column-full">
                                    <GdsFormGroup For="() => Model.ShowResultsAs">
                                        <GdsLabel Text="Show results as" />
                                        <GdsErrorMessage />
                                        <InputSelect @bind-Value="Model.ShowResultsAs" class="govuk-select">
                                            <option value="">Select an option</option>
                                            @foreach (var searchType in Enum.GetValues<ResultTypes>())
                                            {
                                                <option value="@searchType">@searchType</option>
                                            }
                                        </InputSelect>
                                    </GdsFormGroup>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">
                            <div class="govuk-grid-row">
                                <div class="govuk-grid-column-full">
                                    @if (!_isLoading)
                                    {
                                        <button type="submit" data-prevent-double-click="true" class="govuk-button" data-module="govuk-button">Search</button>
                                    }
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

        </EditForm>
    </Authorized>

    <NotAuthorized>
        <GdsWarning Text="Please sign in to search" />
    </NotAuthorized>
</AuthorizeView>
