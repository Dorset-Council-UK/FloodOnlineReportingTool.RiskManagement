@page "/search/options/{SearchReference}"
@page "/search/options"

@using FloodOnlineReportingTool.RiskManagement.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBreadcrumbs Items="Breadcrumbs" />

@if (_isLoading)
{
    <GdsSpinner Show ShowMessage />
}
else
{
    <AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
        <Authorized>
            <EditForm EditContext="EditContext" OnSubmit="OnSubmit" FormName="CreateSearchOptions">
                <FluentValidationValidator />
                <GdsErrorSummary />

                @if (!_canEdit)
                {
                    <GdsWarning Text="This search is locked and cannot be modified" />
                }

                <div class="govuk-form-group">
                    <GdsFieldsetGroup LegendTextSize="GdsSize.Medium">
                        <Heading>
                            <GdsHeading Level="2" class="govuk-fieldset__heading">Search options</GdsHeading>
                        </Heading>
                        <Content>
                            <GdsGridRow>
                                <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                                    <GdsInputDate Id="search-start" For="() => Model.FromDate">
                                        <Heading>
                                            <GdsLabel For="Model.FromDate" Text="Reports from" />
                                        </Heading>
                                    </GdsInputDate>
                                </GdsGridColumn>
                                <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                                    <GdsInputDate Id="search-end" For="() => Model.ToDate">
                                        <Heading>
                                            <GdsLabel For="Model.ToDate" Text="Report until" />
                                        </Heading>
                                    </GdsInputDate>
                                </GdsGridColumn>
                            </GdsGridRow>
                        </Content>
                    </GdsFieldsetGroup>
                </div>

                <div class="govuk-form-group">
                    <GdsFieldsetGroup>
                        <GdsGridRow>
                            <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                                <GdsFormGroup For="() => Model.ByPersonsName">
                                    <GdsLabel Text="Search for reports by the person's name" />
                                    <GdsErrorMessage />
                                    <GdsInputText @bind-Value=Model.ByPersonsName class="govuk-input govuk-input--width-50" disabled="@(!_canEdit)" />
                                </GdsFormGroup>
                            </GdsGridColumn>
                            <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                                <GdsFormGroup For="() => Model.ByPostcode">
                                    <GdsLabel Text="Search by affected postcode" />
                                    <GdsErrorMessage />
                                    <GdsInputText @bind-Value=Model.ByPostcode class="govuk-input govuk-input--width-25" disabled="@(!_canEdit)" />
                                </GdsFormGroup>
                            </GdsGridColumn>
                        </GdsGridRow>
                    </GdsFieldsetGroup>
                </div>

                <div class="govuk-form-group">
                    <GdsGridRow>
                        <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                            <GdsFieldsetGroup>
                                <GdsLabel Text="Filter results by the source of flooding" />
                                <GdsHint>Select all that apply</GdsHint>
                                <GdsErrorMessage />
                                <GdsCheckboxes Smaller Options="_floodSourceOptions" />
                            </GdsFieldsetGroup>
                        </GdsGridColumn>
                        <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                            <div style="height:400px;" class="govuk-!-margin-bottom-2">
                                <MiniMap Geometry="Model.ByPolygon"></MiniMap>
                            </div>
                            <GdsButton IsSubmit="false" PreventDoubleClick AdditionalCssClasses="govuk-button--secondary" OnClick="@GoToMap" Text="Add or modify search area" disabled="@(!_canEdit)" />
                        </GdsGridColumn>
                    </GdsGridRow>
                </div>

                @if (_canEdit)
                {
                    <div class="govuk-form-group">
                        <GdsFieldsetGroup>
                            <GdsGridRow>
                                <GdsGridColumn Width="GdsGridColumnWidth.Full">
                                    <button type="submit" data-prevent-double-click="true" class="govuk-button" data-module="govuk-button">Search</button>
                                    <GdsButton IsSubmit PreventDoubleClick Text="Search" />
                                </GdsGridColumn>
                            </GdsGridRow>
                        </GdsFieldsetGroup>
                    </div>
                }
            </EditForm>
        </Authorized>

        <NotAuthorized>
            <GdsWarning Text="You do not have permission to search. Contact your administrator to request permission." />
        </NotAuthorized>
    </AuthorizeView>
}
