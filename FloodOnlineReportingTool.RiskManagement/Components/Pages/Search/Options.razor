@page "/search/options/{SearchReference}"
@page "/search/options"

@using FloodOnlineReportingTool.Contracts.Shared
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using FloodOnlineReportingTool.RiskManagement.Models.Order
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBreadcrumbs Items="Breadcrumbs" />

@if (_isLoading)
{
    <GdsSpinner Show ShowMessage />
}
else
{
    <AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
        <Authorized>
            <EditForm EditContext="EditContext" OnSubmit="OnSubmit" FormName="CreateSearchOptions">
                <FluentValidationValidator />
                <GdsErrorSummary />

                @if (!_canEdit)
                {
                    <GdsWarning Text="This search is locked and cannot be modified" />
                }

                <GdsHeading Level="2" Size="GdsSize.Medium">Search options</GdsHeading>

                <GdsGridRow>
                    <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                        <GdsFormGroup>
                            <GdsInputDate For="() => Model.FromDate" LegendSize="GdsSize.Medium">
                                <Heading>
                                    <GdsFieldsetHeading Level="3">Reports from</GdsFieldsetHeading>
                                </Heading>
                            </GdsInputDate>
                        </GdsFormGroup>
                    </GdsGridColumn>
                    <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                        <GdsFormGroup>
                            <GdsInputDate For="() => Model.ToDate" LegendSize="GdsSize.Medium">
                                <Heading>
                                    <GdsFieldsetHeading Level="3">Report until</GdsFieldsetHeading>
                                </Heading>
                            </GdsInputDate>
                        </GdsFormGroup>
                    </GdsGridColumn>
                </GdsGridRow>

                <GdsGridRow>
                    <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                        <GdsFormGroup>
                            <GdsLabel Text="Search for reports by the person's name" />
                            <GdsErrorMessage />
                            <GdsInputText @bind-Value=Model.ByPersonsName class="govuk-input govuk-input--width-50" disabled="@(!_canEdit)" />
                        </GdsFormGroup>
                    </GdsGridColumn>
                    <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                        <GdsFormGroup>
                            <GdsLabel Text="Search by affected postcode" />
                            <GdsErrorMessage />
                            <GdsInputText @bind-Value=Model.ByPostcode class="govuk-input govuk-input--width-25" disabled="@(!_canEdit)" />
                        </GdsFormGroup>
                    </GdsGridColumn>
                </GdsGridRow>

                <GdsGridRow>
                    <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                        <GdsFormGroup>
                            <GdsFieldsetGroup>
                                <GdsFieldsetLegend Size="GdsSize.Small">
                                    <GdsFieldsetHeading Level="2">Filter results by the source of flooding</GdsFieldsetHeading>
                                </GdsFieldsetLegend>

                                <GdsHint>Select all that apply</GdsHint>
                                <GdsErrorMessage />

                                <GdsCheckboxes For="() => Model.ByFloodSource" Smaller>
                                    @foreach(var floodProblem in _primaryFloodProblems)
                                    {
                                        string key = floodProblem.Id.ToString("N");
                                        string id = $"flood-source-{key}";
                                        bool isNotSure = floodProblem.Id == PrimaryCauseIds.NotSure;

                                        if (isNotSure)
                                        {
                                            <GdsCheckboxDivider />
                                        }

                                        <GdsCheckboxItem>
                                            <GdsInputCheckbox Id="@id" @bind-Value="@_selectedFloodSources[key]" OnChanged="isChecked => OnFloodSourceChanged(isChecked, floodProblem.Id)" Exclusive="isNotSure" />
                                            <GdsCheckboxLabel Text="@floodProblem.TypeName" />
                                        </GdsCheckboxItem>
                                    }
                                </GdsCheckboxes>
                            </GdsFieldsetGroup>
                        </GdsFormGroup>
                    </GdsGridColumn>

                    <GdsGridColumn Width="GdsGridColumnWidth.OneHalf">
                        <div style="height:400px;" class="govuk-!-margin-bottom-2">
                            <MiniMap Geometry="Model.ByPolygon"></MiniMap>
                        </div>
                        <GdsButton IsSubmit="false" PreventDoubleClick AdditionalCssClasses="govuk-button--secondary" OnClick="@GoToMap" Text="Add or modify search area" disabled="@(!_canEdit)" />
                    </GdsGridColumn>
                </GdsGridRow>

                @if (_warnings.Length > 0)
                {
                    <div class="govuk-!-margin-bottom-6">
                        <GdsWarning Text="@_warnings[0]" />
                        @if (_warnings.Length > 1)
                        {
                            <ul class="govuk-list">
                                @for (int i = 1; i < _warnings.Length; i++)
                                {
                                    var warning = _warnings[i];
                                    bool containsBlazorLink = warning.Contains("<a href=\"search/results/");
                                    if (containsBlazorLink)
                                    {
                                        <li>@((MarkupString)warning)</li>
                                    }
                                    else
                                    {
                                        <li>@warning</li>
                                    }
                                }
                            </ul>
                        }
                    </div>
                }

                @if (_overlappingFloodEvents.Count > 0)
                {
                    <div class="govuk-!-margin-bottom-6">
                        <GdsWarning Text="@(_overlappingFloodEvents.Count == 1 ? "This search overlaps with an existing flood event." : $"This search overlaps with {_overlappingFloodEvents.Count} existing flood events.")" />
                        <p class="govuk-body">Check whether this is the same flood event before creating a new one. An overlap is where the search area, dates and at least one source of flooding are the same.</p>
                        <ul class="govuk-list govuk-list--bullet">
                            @foreach (var overlappingFloodEvent in _overlappingFloodEvents)
                            {
                                var overlappingSearch = overlappingFloodEvent.SavedSearch;
                                <li>
                                    <a href="@($"{EventPages.View.Url}/{overlappingSearch.Reference}")" class="govuk-link govuk-link--no-visited-state">Flood event @overlappingSearch.Reference</a>
                                    @if (!string.IsNullOrWhiteSpace(overlappingSearch.SearchTitle))
                                    {
                                        <span> - @overlappingSearch.SearchTitle</span>
                                    }
                                    <span>, from @(overlappingSearch.ResultsFrom is null ? "-" : overlappingSearch.ResultsFrom.GdsReadable()) until @(overlappingSearch.ResultsTo is null ? "-" : overlappingSearch.ResultsTo.GdsReadable())</span>
                                    @{
                                        var sourceNames = FloodSourceNames(overlappingSearch.FloodSources);
                                    }
                                    @if (!string.IsNullOrWhiteSpace(sourceNames))
                                    {
                                        <span>, source of flooding: @sourceNames</span>
                                    }
                                </li>
                            }
                        </ul>
                        <p class="govuk-body">If this is a different flood event you can continue with your search.</p>
                        <GdsButton IsSubmit="false" PreventDoubleClick AdditionalCssClasses="govuk-button--warning" OnClick="@ContinueIgnoringOverlaps" Text="Continue with this search anyway" disabled="@(!_canEdit)" />
                    </div>
                }

                <GdsGridRow>
                    <GdsGridColumn Width="GdsGridColumnWidth.Full">
                        <GdsButton IsSubmit PreventDoubleClick Text="Search" disabled="@(!_canEdit)" />
                    </GdsGridColumn>
                </GdsGridRow>
            </EditForm>
        </Authorized>

        <NotAuthorized>
            <GdsWarning Text="You do not have permission to search. Contact your administrator to request permission." />
        </NotAuthorized>
    </AuthorizeView>
}
