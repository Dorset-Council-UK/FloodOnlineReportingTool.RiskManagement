@page "/search"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBreadcrumbs Items="Breadcrumbs" />

<AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
    <Authorized>
        <EditForm EditContext="editContext" OnSubmit="OnSubmit" FormName="CreateSearch">
            <FluentValidationValidator />
            <GdsErrorSummary />


            <GdsFormGroup For="() => _isReferenceKnown" Id="reference_or_search">
                <InputRadioGroup @bind-Value="_isReferenceKnown">
                    <GdsFieldsetGroup>
                        <Heading>
                            <h1 class="govuk-fieldset__heading">Do you know the flood report reference or title?</h1>
                        </Heading>
                        <Content>
                            <GdsHint>Select one option.</GdsHint>
                            <GdsErrorMessage />
                            <div class="govuk-radios" data-module="govuk-radios">
                                @foreach (var option in _isReferenceKnownOptions)
                                {
                                    var conditionalId = option.Value ? "conditional-known" : null;
                                    <GdsRadio Option="option" ConditionalId="@conditionalId" />
                                    if (conditionalId != null)
                                    {
                                        <div class="govuk-radios__conditional govuk-radios__conditional--hidden" id="@conditionalId">
                                            <GdsFormGroup For="@(() => Model.ByReference)">
                                                <GdsLabel Text="Please provide the flood report reference or title" />
                                                <GdsErrorMessage />
                                                <GdsInputText @bind-Value=Model.ByReference class="govuk-input govuk-input--width-10" />
                                            </GdsFormGroup>
                                        </div>
                                    }
                                }
                            </div>
                        </Content>
                    </GdsFieldsetGroup>
                </InputRadioGroup>
            </GdsFormGroup>

            <p><button type="submit" data-prevent-double-click="true" class="govuk-button" data-module="govuk-button">Search</button></p>

        </EditForm>
    </Authorized>

    <NotAuthorized>
        <GdsWarning Text="Please sign in to search for flood locations" />
    </NotAuthorized>
</AuthorizeView>

