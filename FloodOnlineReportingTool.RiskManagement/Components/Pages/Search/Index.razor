@page "/search"
@using FloodOnlineReportingTool.RiskManagement.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBreadcrumbs Items="Breadcrumbs" />

<AuthorizeView Policy="@PolicyNames.Reader" Context="authContext">
    <Authorized>
        <EditForm EditContext="editContext" OnSubmit="OnSubmit" FormName="CreateSearch">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsFormGroup>
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="1">Do you know a reference number or flood event title?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select one option</GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="_isReferenceKnown">
                        <GdsRadioItem>
                            <GdsInputRadio Value="@true" ConditionalId="conditional-known" />
                            <GdsRadioLabel Text="Yes" />
                        </GdsRadioItem>
                        <GdsRadioConditional Id="conditional-known">
                            <GdsFormGroup>
                                <GdsLabel Text="Enter the search reference or title" />
                                <GdsErrorMessage />
                                <GdsInputText @bind-Value="Model.ByReference" class="govuk-input govuk-input--width-10" />
                            </GdsFormGroup>
                        </GdsRadioConditional>

                        <GdsRadioItem>
                            <GdsInputRadio Value="@false" />
                            <GdsRadioLabel Text="No" />
                        </GdsRadioItem>
                    </GdsRadios>
                </GdsFieldsetGroup>
            </GdsFormGroup>

            <p><GdsButton IsSubmit PreventDoubleClick Text="Search" /></p>
        </EditForm>
    </Authorized>

    <NotAuthorized>
        <GdsWarning Text="Please sign in to search for flood locations" />
    </NotAuthorized>
</AuthorizeView>

