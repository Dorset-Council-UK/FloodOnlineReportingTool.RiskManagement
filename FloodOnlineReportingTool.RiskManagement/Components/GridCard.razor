<div class="@SizeOption info_panel__clickable">
    <div class="info_panel__item @SelectedStyle">
        <div class="info_panel__content">
            <a class="info_panel__link" href="@LinkURL"></a>
            <h3 style="display:flex; justify-content:space-between; align-items:center;">
                <span>@HeaderText</span>
                <span>@CardTag</span>
            </h3>
            <p>@BodyText</p>
        </div>
    </div>
</div>




