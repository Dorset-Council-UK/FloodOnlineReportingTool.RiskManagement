@using Microsoft.AspNetCore.Components.QuickGrid

<div class="govuk-button-group govuk-!-margin-bottom-3">
    <button type="button" class="govuk-button @(_showGrouped ? "" : "govuk-button--secondary")" @onclick="() => _showGrouped = true">Grouped</button>
    <button type="button" class="govuk-button @(!_showGrouped ? "" : "govuk-button--secondary")" @onclick="() => _showGrouped = false">Flat</button>
</div>

<div class="govuk-!-font-weight-bold govuk-!-margin-bottom-3">@SearchResults.TotalCount flood reports found, with @SearchResults.TotalFloodSourceCount sources</div>

<div class="grid">
    @if (_showGrouped)
    {
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header toggle-col"></th>
                    <th scope="col" class="govuk-table__header">Reference</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <th scope="col" class="govuk-table__header">Record type</th>
                    <th scope="col" class="govuk-table__header">Impact start</th>
                    <th scope="col" class="govuk-table__header">Causes</th>
                    <th scope="col" class="govuk-table__header"></th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var row in SearchResults.Results)
                {
                    var isExpanded = _expandedRows.Contains(row.Id);
                    <tr class="govuk-table__row report-row">
                        <td class="govuk-table__cell toggle-col">
                            <button class="toggle-btn" @onclick="() => Toggle(row.Id)"
                                    aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                                    aria-label="@(isExpanded ? "Collapse" : "Expand") sources for @row.Reference">
                                @(isExpanded ? "▼" : "▶")
                            </button>
                        </td>
                        <td class="govuk-table__cell">
                            @row.Reference
                        </td>
                        <td class="govuk-table__cell">
                            @row.RecordStatus
                        </td>
                        <td class="govuk-table__cell">
                            @row.SourceRecords.Count @(row.SourceRecords.Count == 1 ? "source" : "sources")
                        </td>
                        <td class="govuk-table__cell"><span class="govuk-visually-hidden">Expand this row to view impact start dates</span></td>
                        <td class="govuk-table__cell"><span class="govuk-visually-hidden">Expand this row to view flood sources</span></td>
                        <td class="govuk-table__cell">
                            <a href="report/details/@row.Reference">View details<span class="govuk-visually-hidden"> for record @row.Reference</span></a>
                        </td>
                    </tr>
                    @if (isExpanded)
                    {
                        foreach (var source in row.SourceRecords)
                        {
                            <tr class="govuk-table__row source-row">
                                <td class="govuk-table__cell"></td>
                                <td class="govuk-table__cell">
                                    @source.Reference
                                </td>
                                <td class="govuk-table__cell"></td>
                                <td class="govuk-table__cell">Source</td>
                                <td class="govuk-table__cell">@source.ImpactStartUtc.GdsReadable()</td>
                                <td class="govuk-table__cell">
                                    @(source.Causes.Count == 1 ? source.Causes.First().Name : $"{source.Causes.Count} causes")
                                </td>
                                <td class="govuk-table__cell">
                                    <a href="@source.ViewUri" target="_blank" rel="noopener noreferrer" class="govuk-link">View details<span class="govuk-visually-hidden"> for record @source.Reference</span></a>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <QuickGrid Items="FlatItems" class="govuk-table">
            <TemplateColumn Title="Report" SortBy="GridSort<FlatSourceRow>.ByAscending(r => r.ReportReference)" >
                <a href="report/details/@context.ReportReference" class="govuk-link">@context.ReportReference</a>
            </TemplateColumn>
            <PropertyColumn Title="Record Status" Property="r => r.RecordStatus" />
            <TemplateColumn Title="Source Reference" SortBy="GridSort<FlatSourceRow>.ByAscending(r => r.SourceReference)">
                <a href="@context.ViewUri" target="_blank" rel="noopener noreferrer" class="govuk-link">@context.SourceReference</a>
            </TemplateColumn>
            <TemplateColumn Title="Impact Start" SortBy="GridSort<FlatSourceRow>.ByAscending(r => r.ImpactStartUtc ?? DateTimeOffset.MinValue)">
                @context.ImpactStartUtc.GdsReadable()
            </TemplateColumn>
            <PropertyColumn Title="Causes" Property="r => r.CausesDisplay" />
        </QuickGrid>
    }
    <PaginationRow CurrentPage="@SearchResults.CurrentPage" LastPage="@SearchResults.TotalPages" OnPageChanged="OnPageChanged" />
</div>
