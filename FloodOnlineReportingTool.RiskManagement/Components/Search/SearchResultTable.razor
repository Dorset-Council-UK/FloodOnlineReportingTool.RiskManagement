@using FloodOnlineReportingTool.Contracts.Shared.Search
@using Microsoft.AspNetCore.Components.QuickGrid

<div class="grid">
    <QuickGrid @ref="_grid" ItemsProvider="ItemsProvider" Pagination="_pagination" class="govuk-table quickgrid-hide-empty-rows">
        <TemplateColumn Title="Reference">
            <a href="@context.ViewUri" target="_blank" class="govuk-link">@context.Reference</a>
        </TemplateColumn>
        <TemplateColumn Title="Status">
            @context.RecordStatus
        </TemplateColumn>
        <TemplateColumn Title="Impact Start">
            @context.ImpactStartUtc.GdsReadable()
        </TemplateColumn>
        <TemplateColumn Title="Reported">
            @context.CreatedUtc.GdsReadable()
        </TemplateColumn>
        <TemplateColumn Title="Causes">
            @(context.Causes.Count > 0 ? string.Join(", ", context.Causes.Select(s => s.Name)) : "No flooding sources identified")
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="_pagination"  />
</div>