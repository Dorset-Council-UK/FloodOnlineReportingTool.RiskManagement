@using FloodOnlineReportingTool.Contracts.Shared.Search
@using FloodOnlineReportingTool.RiskManagement.Models.Search

<div class="grid">
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header toggle-col"></th>
                <th scope="col" class="govuk-table__header">Report</th>
                <th scope="col" class="govuk-table__header">Source Reference</th>
                <th scope="col" class="govuk-table__header">Impact Start</th>
                <th scope="col" class="govuk-table__header">Reported</th>
                <th scope="col" class="govuk-table__header">Causes</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var row in SearchResults.Results)
            {
                var isExpanded = _expandedRows.Contains(row.Id);
                <tr class="govuk-table__row report-row">
                    <td class="govuk-table__cell toggle-col">
                        <button class="toggle-btn" @onclick="() => Toggle(row.Id)"
                                aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                                aria-label="@(isExpanded ? "Collapse" : "Expand") sources for @row.Reference">
                            @(isExpanded ? "▼" : "▶")
                        </button>
                    </td>
                    <td class="govuk-table__cell" colspan="5">
                        <span class="govuk-!-font-weight-bold">@row.Reference</span>
                        <strong class="govuk-tag govuk-tag--grey govuk-!-margin-left-2">@row.RecordStatus</strong>
                        <span class="govuk-body-s govuk-!-margin-left-2 source-count">
                            @row.SourceRecords.Count @(row.SourceRecords.Count == 1 ? "source" : "sources")
                        </span>
                    </td>
                </tr>
                @if (isExpanded)
                {
                    foreach (var source in row.SourceRecords)
                    {
                        <tr class="govuk-table__row source-row">
                            <td class="govuk-table__cell"></td>
                            <td class="govuk-table__cell"></td>
                            <td class="govuk-table__cell">
                                <a href="@source.ViewUri" target="_blank" rel="noopener noreferrer" class="govuk-link">@source.Reference</a>
                            </td>
                            <td class="govuk-table__cell">@source.ImpactStartUtc.GdsReadable()</td>
                            <td class="govuk-table__cell">@source.CreatedUtc.GdsReadable()</td>
                            <td class="govuk-table__cell">
                                @(source.Causes.Count > 0 ? string.Join(", ", source.Causes.Select(c => c.Name)) : "No flooding sources identified")
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
    <PaginationRow CurrentPage="@SearchResults.CurrentPage" LastPage="@SearchResults.TotalPages" OnPageChanged="OnPageChanged" />
</div>
