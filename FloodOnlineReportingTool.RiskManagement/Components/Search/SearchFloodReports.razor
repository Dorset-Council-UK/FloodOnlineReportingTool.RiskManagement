@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView Context="authContext">
    <Authorized>
        <GdsSpinner Show="_isLoading" ShowMessage="true" />

        @if (!_isLoading)
        {
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-third">
                    <div class="govuk-body-s">
                        <EditForm EditContext="_editContext" OnSubmit="OnSearchFloodReport" FormName="SearchFloodReports">
                            <FluentValidationValidator />

                            <GdsFormGroup For="() => Search.UprnText" Id="uprn">
                                <GdsLabel Text="UPRN" />
                                <GdsHint>Must be a <abbr title="Unique Property Reference Number">UPRN</abbr> in the United Kingdom</GdsHint>
                                <GdsErrorMessage />
                                <GdsInputNumber @bind-Value=Search.UprnText @bind-WholeNumber=Search.Uprn class="govuk-input govuk-input--width-10" />
                            </GdsFormGroup>

                            <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                        </EditForm>
                    </div>
                </div>

                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-grid-row">
                        <div>@(_searchResult?.FloodReports.Count ?? 0) results found</div>
                    </div>
                    <div class="govuk-grid-row">
                        <div>TODO: Sort goes here</div>
                    </div>
                    <div class="govuk-grid-row">
                        @switch (_searchState)
                        {
                            case SearchState.NotStarted:
                                <p>TODO: Add initial search instructions, if relevant.</p>
                                break;

                            case SearchState.Searching:
                                <GdsSpinner Show="@true" ShowMessage="true" Message="Searching..." />
                                break;

                            case SearchState.ResultsFound:
                                if (_searchResult?.FloodReports.Count > 0)
                                {
                                    @foreach (var floodReport in _searchResult.FloodReports)
                                    {
                                        <div>
                                            <div>Title goes here</div>
                                            <div>Summary goes here</div>
                                            <div>Date goes here, ideally updated</div>
                                        </div>
                                    }
                                }
                                break;

                            case SearchState.NoResults:
                                <p class="govuk-!-font-weight-bold">There are no matching results.</p>
                                <p>Improve your search results by:</p>
                                <ul class="govuk-list govuk-list--bullet">
                                    <li>removing filters</li>
                                    <li>double-checking your spelling</li>
                                    <li>using fewer keywords</li>
                                    <li>searching for something less specific</li>
                                </ul>
                                break;

                            case SearchState.Error:
                                if (_searchResult?.Errors.Count > 0)
                                {
                                    <div class="govuk-error-summary" data-module="govuk-error-summary">
                                        <div role="alert">
                                            <h2 class="govuk-error-summary__title">There is a problem</h2>
                                            <div class="govuk-error-summary__body">
                                                <ul class="govuk-list govuk-error-summary__list">
                                                    @foreach (var message in _searchResult.Errors)
                                                    {
                                                        <li>@message</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }
                                break;
                        }

                        <div>
                            <div>TODO: Once the search service contains paging build this next page feature.</div>
                            <div>Next page</div>
                            <div>2 of xx</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <p>You do not have permission to search for flood reports.</p>
    </NotAuthorized>
</AuthorizeView>