@using FloodOnlineReportingTool.Contracts.Shared.Search
@using FloodOnlineReportingTool.RiskManagement.Models.Search

<div itemscope itemtype="https://schema.org/CreativeWork" class="govuk-!-padding-top-3 govuk-!-padding-bottom-3 border-top">
    <h2 class="govuk-heading-m" itemprop="headline">@SearchResult.Reference</h2>
    <strong class="govuk-tag govuk-tag--grey govuk-!-margin-bottom-2">@SearchResult.RecordStatus</strong>
    <details class="govuk-details govuk-!-margin-top-2 govuk-!-margin-bottom-0">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">
                @SearchResult.SourceRecords.Count @(SearchResult.SourceRecords.Count == 1 ? "source" : "sources")
            </span>
        </summary>
        <div class="govuk-details__text">
            @foreach (var source in SearchResult.SourceRecords)
            {
                <div class="govuk-!-margin-bottom-4">
                    <p class="govuk-body govuk-!-margin-bottom-1">
                        <a href="@source.ViewUri" target="_blank" rel="noopener noreferrer" class="govuk-link">@source.Reference</a>
                    </p>
                    <p class="govuk-body-s govuk-!-margin-bottom-1">Flooding started @source.ImpactStartUtc.GdsReadable()</p>
                    <p class="govuk-body-s govuk-!-margin-bottom-1">
                        @(source.Causes.Count > 0 ? string.Join(", ", source.Causes.Select(s => s.Name)) : "No flooding causes identified")
                    </p>
                    @if (source.UpdatedUtc is not null)
                    {
                        <p class="govuk-body-s govuk-!-margin-bottom-0" style="color: var(--govuk-color-dark-grey)" itemprop="dateModified" content="@source.UpdatedUtc.Value.ToString("O")">
                            Updated @source.UpdatedUtc.GdsReadable()
                        </p>
                    }
                    else
                    {
                        <p class="govuk-body-s govuk-!-margin-bottom-0" style="color: var(--govuk-color-dark-grey)" itemprop="dateCreated" content="@source.CreatedUtc.ToString("O")">
                            Created @source.CreatedUtc.GdsReadable()
                        </p>
                    }
                </div>
            }
        </div>
    </details>
</div>

@code {
    [Parameter, EditorRequired]
    public FloodReportTableRow SearchResult { get; set; } = default!;
}