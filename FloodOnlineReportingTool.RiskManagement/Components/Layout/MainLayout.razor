@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@inherits LayoutComponentBase

<GdsHeader ServiceName="Risk Management" ServiceUrl="" LogoUrl="@Assets["images/logos/logo.webp"]">
    @if (!Env.IsProduction())
    {
        <div class="govuk-header__service-name govuk-!-display-block">This is <strong>@Env.EnvironmentName</strong>!</div>
    }
    <AuthorizeView Policy="AuthenticatedOnly">
        <Authorized>
            <ul class="navbar-nav ps-3">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle"></i> @context.User.Identity?.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" data-bs-popper="static">
                        <li><h6 class="dropdown-header">@(context.User.Claims.FirstOrDefault(c => c.Type.Contains("email")) != null ? context.User.Claims.FirstOrDefault(c => c.Type.Contains("email"))!.Value : "")</h6></li>
                        <AuthorizeView Policy="CanAccessApp" Context="InnerAccountBox">
                            <li><a class="dropdown-item" href="Account/MyAccount">My Account</a></li>
                            @if (InnerAccountBox.User.IsInRole("Administrator"))
                            {
                                <li><a class="dropdown-item" href="management">Manage Application</a></li>
                            }
                        </AuthorizeView>

                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form action="MicrosoftIdentity/Account/SignOut">
                                <button id="logout" class="btn btn-outline-danger btn-sm ms-2"><i class="bi-door-open"></i> Logout</button>
                            </form>
                        </li>
                    </ul>
                </li>

            </ul>
        </Authorized>
        <NotAuthorized>
            <a id="login" class="btn btn-outline-primary btn-sm ms-2" href="MicrosoftIdentity/Account/SignIn"><i class="bi-door-open"></i> Sign In</a>
        </NotAuthorized>
    </AuthorizeView>
        

</GdsHeader>

<div class="govuk-width-container">
    <GdsPhaseBanner Phase="GdsPhaseBanner.Phases.Alpha" FeedbackLink="_feedbackUri" />

    <SectionOutlet SectionName="Layout.GdsBreadcrumbs" />

    <main class="govuk-main-wrapper govuk-body" id="main-content" role="main">
        @Body
    </main>
</div>

<GdsFooter />

@code {
    [Inject]
    public IWebHostEnvironment Env { get; set; } = default!;

    private readonly Uri _feedbackUri = new("https://dorset-self.achieveservice.com/service/flood-reporting-tool-feedback");
}
