[*]
spelling_languages=en-gb

[*.cs]
# MA0004: Use Task.ConfigureAwait
dotnet_diagnostic.MA0004.severity = none

# Disable all analyzers in Migrations folder
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Disable Namespace does not match folder structure in Entensions folder
[**/Extensions/*.cs]
dotnet_diagnostic.IDE0130.severity = none
